#!/bin/bash
#  Copyright 2013 Jesse 'Jeaye' Wilkerson
#  See licensing in LICENSE file, or at:
#      http://www.opensource.org/licenses/BSD-3-Clause
#
#  File: configure
#  Author: Jesse 'Jeaye' Wilkerson
#  Description:
#    Submodule and configuration manager.
#

# Re-invoke the configure script
# and keep the output at bay.
if [[ $# != 1 || $1 != "quiet" ]]; then
  $0 "quiet" > /dev/null
  exit $?
fi

# Exit on errors
set -o errexit
# Exit if we try to use an unbound variable
set -o nounset

# Determine system
supported="linux|darwin|cygwin"
if [[ ! $OSTYPE =~ $supported ]]; then
  echo "$OSTYPE is unsuppported" 1>&2
  exit 1
fi

# Colors
COLOR_OFF=$(tput sgr0)
COLOR_RED=$(tput setaf 1)
COLOR_YELLOW=$(tput setaf 3)
COLOR_GREEN=$(tput setaf 2)

# Output colorizing
ECHO_PREFIX=$COLOR_GREEN"»»»"$COLOR_OFF
if [[ $OSTYPE == "linux*" ]]; then
	ECHO="echo -e $ECHO_PREFIX"
else
	ECHO="echo $ECHO_PREFIX"
fi

log() { $ECHO "$@" 1>&2; }

log "Configuring Q³"
log "WARNING: This project is not actively under development"
log "WARNING: This script will build an old Rust version to run Q³"

case $OSTYPE in
  linux*) log "Platform: Linux" ;;
  darwin*) log "Platform: OSX" ;;
  cygwin*) log "Platform: Cygwin" ;;
esac

# BWD is the build directory
BWD=$PWD/build
log "Build directory: $BWD"

# SWD is the source directory
SWD=$(cd $(dirname $0) && pwd)
log "Source directory: $SWD"

function readlink() {
  DIR=$(echo "${1%/*}")
  cd "$DIR"
  link_res=$(pwd -P)
}

function update() {
  local ext=""
  case $OSTYPE in
    linux* | cygwin*) ext="*.so" ;;
    darwin*) ext="*.dylib" ;;
  esac

  rm -f $BWD/../$1-$ext
  for file in `find build -name $ext`; do
    cp $file $BWD/../
  done
}

# Update submodules
log "Updating submodules"
pushd $SWD
  git submodule update --recursive --init --depth=1
popd

# Clean up any previous build data
rm -rf build
mkdir -p build
cd build

## Rust
log "Building rust (will be a while, build log can be found in $BWD/rust)"
mkdir -p rust
pushd rust
  sed -i 's#CFLAGS=\$LLVM_CFLAGS$#CFLAGS="\$LLVM_CFLAGS -std=gnu99"#' $SWD/lib/rust/configure
  sed -i 's#CFG_GCCISH_CFLAGS :=$#CFG_GCCISH_CFLAGS := -w#' $SWD/lib/rust/Makefile.in
  sh $SWD/lib/rust/configure --prefix=$SWD > build_log.txt 2>&1
  { make -j8 && make install; } >> build_log.txt 2>&1
popd
PATH=$SWD/bin:$PATH

## GLFW3 Rust
log "Building glfw-rs"
mkdir -p glfw-rs
pushd $SWD/lib/glfw-rs
  rustpkg clean glfw
  rustpkg build glfw
  update libglfw
popd

## OpenGL ES
log "Building rust-opengles"
mkdir -p rust-opengles
pushd rust-opengles
  sed -i "s#sys#mem#" $SWD/lib/rust-opengles/gl2.rs
  sh $SWD/lib/rust-opengles/configure
  make clean
  make -B
popd

## Rust OpenGL
log "Building gl-rs"
mkdir -p gl-rs
pushd $SWD/lib/gl-rs
  rustpkg clean gl
  rustpkg build --opt-level=3 gl
  update libgl
popd

## STB-Image
log "Building stb-image"
mkdir -p stb-image
pushd stb-image
  sh $SWD/lib/stb-image/configure
  make clean
  make -B
popd

## Rust ncurses
log "Building ncurses-rs"
mkdir -p ncurses-rs
pushd ncurses-rs
  pushd $SWD/lib/ncurses-rs
    make clean
    make -B
    mv lib/libncurses* $BWD/ncurses-rs/
  popd
popd

## Q³
cd .. # Back to the original invoking directory

# Move over the make file
sed "s#%PROJ_DIR%#${SWD}#" $SWD/Makefile.stub > Makefile

readlink $SWD/build
swd_link=$link_res
readlink $BWD
bwd_link=$link_res
if [[ $swd_link != $bwd_link ]]; then
  # Link the data directory, since this is an out of source build
  ln -sf $SWD/data data
fi

# Require a clean build
find . -maxdepth 1 -type f -name '.build_*' | grep -v git | xargs rm -f || true

log "Done configuring Q³."
