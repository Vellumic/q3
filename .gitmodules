[submodule "lib/rust-opengles"]
	path = lib/rust-opengles
	url = https://github.com/servo/rust-opengles.git
	ignore = dirty
[submodule "lib/glfw-rs"]
	path = lib/glfw-rs
	url = https://github.com/PistonDevelopers/glfw-rs.git
	ignore = dirty
[submodule "lib/stb-image"]
	path = lib/stb-image
	url = https://github.com/servo/rust-stb-image.git
	ignore = dirty
[submodule "lib/ncurses-rs"]
	path = lib/ncurses-rs
	url = https://github.com/jeaye/ncurses-rs.git
	ignore = dirty
[submodule "lib/gl-rs"]
	path = lib/gl-rs
	url = https://github.com/rust-windowing/gl-rs.git
	ignore = dirty
[submodule "lib/rust"]
	path = lib/rust
	url = https://github.com/rust-lang/rust.git
	ignore = dirty
